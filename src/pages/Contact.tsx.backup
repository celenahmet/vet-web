                      <span className="min-w-0 truncate text-sm">
                        <span className="font-bold text-slate-900 dark:text-white">+90</span> <span className="text-xs ml-1">TR</span>
                      </span>
                      <ChevronDown size={16} className="shrink-0 text-slate-500" />
