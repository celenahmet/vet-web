                  </div>
                  <input id="phone" type="tel" placeholder={t('contact_form_phone_placeholder')} className="w-full px-4 py-3 bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 rounded-xl focus:outline-none focus:border-[#009689] focus:ring-2 focus:ring-[#009689]/20 transition-all text-sm text-slate-900 dark:text-white placeholder:text-slate-400" />
                </div>
                <p className="mt-1.5 text-[11px] text-slate-500 dark:text-slate-400">{t('contact_form_phone_hint')}</p>
              </div>

              <div>
